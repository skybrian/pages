<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title | escape }}{% if page.url != '/' %} · skybrian’s pages{% endif %}</title>
  {% if description %}<meta name="description" content="{{ description | escape }}">{% endif %}
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  {% include "preview-ribbon.njk" %}
  <main>
    {% if page.url != '/' %}<nav aria-label="Home"><a href="/">← All pages</a></nav>{% endif %}
    <header>
      <h1>{{ title | escape }}</h1>
      {% if page.url != '/' and date %}<time datetime="{{ date | isoDate }}">{{ date | isoDate }}</time>{% endif %}
    </header>
    {{ content | safe }}
  </main>
</body>
</html>
