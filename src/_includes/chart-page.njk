<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title | escape }} · skybrian’s pages</title>
  {% if description %}<meta name="description" content="{{ description | escape }}">{% endif %}
  <meta property="og:type" content="article">
  <meta property="og:url" content="https://pages.skybrian.com{{ page.url }}">
  <meta property="og:title" content="{{ title | escape }}">
  {% if description %}<meta property="og:description" content="{{ description | escape }}">{% endif %}
  <meta property="og:image" content="https://pages.skybrian.com/assets/charts/{{ page.fileSlug }}.png">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ description | default(title) | escape }}">
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body class="chart-layout">
  {% include "preview-ribbon.njk" %}
  <main>
    <section class="chart-page" aria-labelledby="chart-heading">
      <header><h1 id="chart-heading">{{ title | escape }}</h1></header>
      {{ page.inputPath | initialCharts("tabs") | safe }}
      <div class="chart-root" data-chart-root aria-busy="false" role="region" aria-label="{{ title | escape }}">
        {{ page.inputPath | initialCharts | safe }}
      </div>
      <div class="chart-actions">
        <a href="./data.json" target="_blank" rel="noopener">View data (JSON)</a>
        <button type="button" data-copy-svg disabled>Copy SVG</button>
      </div>
      <span class="chart-copy-status" data-copy-status role="status" aria-live="polite"></span>
    </section>
    {{ content | safe }}
  </main>
  <script type="module" src="/assets/charts/{{ page.fileSlug }}.js"></script>
</body>
</html>
